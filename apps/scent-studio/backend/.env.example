# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 값(비밀번호·키)은 대화창에 붙여 넣지 않는다. docs/db_design.md 13절 순서대로.
# 아래 < > 는 자리 표시일 뿐 실제 값이 아니다. 값에 따옴표·공백을 넣지 않는다.

# Supabase 대시보드 → 위쪽 Connect → "Session pooler" 칸의 주소를 jdbc: 형식으로 바꿔 넣는다.
#   화면에 보이는 것:  postgresql://postgres.<프로젝트참조값>:[YOUR-PASSWORD]@<호스트>:5432/postgres
#   여기 넣을 것:      jdbc:postgresql://<호스트>:5432/postgres?sslmode=require
#   (사용자 이름과 비밀번호는 주소에 넣지 않고 아래 칸에 따로 넣는다. 호스트 예: aws-0-ap-northeast-2.pooler.supabase.com)
DB_URL=jdbc:postgresql://<호스트>:5432/postgres?sslmode=require

# 표 만들기용 (마이그레이션 때만). 위 화면 주소의 // 와 : 사이 부분 = postgres.<프로젝트참조값>
DB_MIGRATION_USER=postgres.<프로젝트참조값>
# 프로젝트를 만들 때 정한 Database Password (영문·숫자 32자 이상)
DB_MIGRATION_PASSWORD=<DB 비밀번호>

# 공개 키 (Project Settings → API Keys → Publishable key, sb_publishable_ 로 시작). 앱에 들어가는 공개용 키라 비밀은 아니지만 .env에 둔다.
# Secret key(sb_secret_)·service_role 키는 여기에 넣지 않는다.
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# 서버가 평소에 쓰는 계정. 13절 4번에서 비밀번호를 정한 뒤 채운다
DB_SERVER_USER=scent_server.<프로젝트참조값>
DB_SERVER_PASSWORD=<scent_server 비밀번호, 영문·숫자 32자 이상>
