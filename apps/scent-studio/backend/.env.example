# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 값(비밀번호·키)은 대화창에 붙여 넣지 않는다. docs/db_design.md 13절 순서대로.

# Supabase → Connect → Session pooler (포트 5432). 예: jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_URL=

# 표 만들기용 (마이그레이션 때만). 형식: postgres.<프로젝트참조값>
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# 서버가 평소에 쓰는 계정. 형식: scent_server.<프로젝트참조값>. 비밀번호는 영문·숫자 32자 이상
DB_SERVER_USER=
DB_SERVER_PASSWORD=
