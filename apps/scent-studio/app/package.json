{
  "name": "perfumer-lab",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.24",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "fflate": "^0.8.2",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "catalog:prepare": "node scripts/prepare-catalog.mjs",
    "export:web": "node scripts/prepare-catalog.mjs && expo export -p web",
    "export:web:public": "node scripts/prepare-catalog.mjs --public && expo export -p web --output-dir dist && node scripts/prepare-catalog.mjs --verify-dist dist",
    "prebuild:app": "node scripts/prepare-catalog.mjs && expo prebuild",
    "test:unit": "vitest run",
    "test:acceptance": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
